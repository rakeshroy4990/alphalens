# Copy values into Cloud Run / GCE env. Never commit real secrets.
# GCP project: alphalens-508509
# https://console.cloud.google.com/home/dashboard?project=alphalens-508509

PORT=8080
BACKEND_PORT=8088

# Supabase URI (postgresql://). Do not convert this to jdbc: in env files.
SPRING_DATASOURCE_URL=postgresql://postgres:{{password}}@db.nbityfnkiavbzkkacaxm.supabase.co:5432/postgres
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_MAX_POOL_SIZE=5

# Firebase Hosting → Cloud Run is cross-site. Keep these in env-vars-file so they are not wiped.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://alphalens-a3cce.web.app,https://alphalens-a3cce.firebaseapp.com,https://*.web.app,https://*.firebaseapp.com,https://*.run.app
APP_AUTH_COOKIE_SECURE=true
APP_AUTH_COOKIE_CROSS_SITE_DEPLOYMENT=true
