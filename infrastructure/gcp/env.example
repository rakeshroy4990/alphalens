# Copy values into Cloud Run / GCE env. Never commit real secrets.
# GCP project: alphalens-508509
# https://console.cloud.google.com/home/dashboard?project=alphalens-508509

PORT=8080
BACKEND_PORT=8088

# Cloud SQL via Auth Proxy on 127.0.0.1, or a jdbc/postgresql URL.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/alphalens
SPRING_DATASOURCE_USERNAME=alphalens
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_MAX_POOL_SIZE=5

# Same-origin nginx proxy does not need CORS. Add the Cloud Run URL if the UI is hosted separately.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://*.run.app,http://localhost:*
