# Copy to `.env` (gitignored). `./gradlew bootRun` and scripts/start-*.sh load this file.
# Local and Cloud Run both use SPRING_DATASOURCE_URL as-is (no USE_SUPABASE switch).

# --- Local Docker PostgreSQL (only if you intentionally want a machine-local DB) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/alphalens
# SPRING_DATASOURCE_USERNAME=alphalens
# SPRING_DATASOURCE_PASSWORD=alphalens

# --- Supabase PostgreSQL (default for AlphaLens) ---
# Dashboard → Project Settings → Database → Connect → Session pooler (port 5432).
# Direct db.<ref>.supabase.co is often IPv6-only from macOS; use the pooler host.
# Username is usually postgres.<project-ref> for the pooler.
# URL must be jdbc:postgresql://... or postgres://... (rewritten automatically).
# Never put SUPABASE_ANON_KEY or service_role in the Vue app.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_MAX_POOL_SIZE=5

APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
PORT=8088

# JWT signing secret — generate a long random value for any shared/prod database.
# APP_AUTH_JWT_SECRET=
# APP_AUTH_COOKIE_SECURE=true
# APP_AUTH_COOKIE_CROSS_SITE_DEPLOYMENT=true
# Google OAuth Web client id (public). Same value the GIS button uses.
# APP_GOOGLE_OAUTH_WEB_CLIENT_ID=