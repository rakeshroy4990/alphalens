VITE_API_BASE_URL=/api
# Public Google OAuth web client id (optional). Never put client secrets here.
# Public Google OAuth web client id (optional override). The UI also reads it from
# GET /api/auth/client-config (APP_GOOGLE_OAUTH_WEB_CLIENT_ID on the server).
# VITE_GOOGLE_OAUTH_CLIENT_ID=
# Local `npm run dev` always uses /api (see .env.development) so Vite can
# proxy to Spring on :8088. The Cloud Run all-in-one image also uses /api
# (nginx proxies). Firebase Hosting has no proxy — deploy-firebase-hosting.sh
# requires an absolute URL and rejects /api:
# VITE_API_BASE_URL=https://alphalens-113523778150.asia-south1.run.app/api
